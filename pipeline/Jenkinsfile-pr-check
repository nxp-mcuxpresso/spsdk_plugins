@Library('shared-lib') _

pipeline {
    agent none

    options {
        timeout(time: 2, unit: 'HOURS', activity: true)   // timeout on whole pipeline job
    }

    stages {
        stage ("Quick check") {
            agent {
                label 'linux-spsdk'
            }
            steps {
                script {
                    checkoutRepo()
                    checkoutRepo("spsdk", "master", "spsdk_repo")
                    withVenv(
                        'uv python install 3.14 && uv pip install nox tomli',
                        'nox -P 3.14 --session codecheck -- --spsdk spsdk_repo -s -o quick-reports'
                    )
                }
            }
            post {
                always {
                    archiveArtifacts artifacts: "*/quick-reports*/*.txt", allowEmptyArchive: true
                    archiveArtifacts artifacts: "*/quick-reports*/*.html", allowEmptyArchive: true
                    archiveArtifacts artifacts: "reports-summary/*.xml", allowEmptyArchive: true
                    junit allowEmptyResults: true, testResults: "reports-summary/*.xml"
                    junit allowEmptyResults: true, testResults: "*/quick-reports*/tests.xml"
                    emailext(
                        body: '${DEFAULT_CONTENT}', mimeType: 'text/html',
                        replyTo: '$DEFAULT_REPLYTO', subject: '${DEFAULT_SUBJECT}',
                        to: emailextrecipients([
                            [$class: 'CulpritsRecipientProvider'],
                            [$class: 'RequesterRecipientProvider']
                        ])
                    )
                }
            }
        }

        stage ("Full check") {
            matrix {
                agent {
                    label "${AGENT_LABEL}"
                }
                axes {
                    axis {
                        name "AGENT_LABEL"
                        values "linux-spsdk", "mac", "windows-spsdk"
                    }
                }
                stages {
                    stage ("Checkout") {
                        steps {
                            script {
                                if (isUnix()) { } else { bat 'git config core.longPaths true' }
                                checkoutRepo()
                                checkoutRepo("spsdk", "master", "spsdk_repo")
                            }
                        }
                    }
                    stage ("Codecheck") {
                        steps {
                            script {
                                withVenv(
                                    'uv pip install -U uv && uv python install 3.10 3.14 && uv pip install nox tomli',
                                    'nox -P 3.10 3.14 --session codecheck -- --spsdk spsdk_repo -s'
                                )
                            }
                        }
                        post {
                            always {
                                archiveArtifacts artifacts: "*/reports*/*.txt", allowEmptyArchive: true
                                archiveArtifacts artifacts: "*/reports*/*.html", allowEmptyArchive: true
                                archiveArtifacts artifacts: "reports-summary/*.xml", allowEmptyArchive: true
                                junit allowEmptyResults: true, testResults: "reports-summary/*.xml"
                                junit allowEmptyResults: true, testResults: "*/reports*/tests.xml"
                                emailext(
                                    body: '${DEFAULT_CONTENT}', mimeType: 'text/html',
                                    replyTo: '$DEFAULT_REPLYTO', subject: '${DEFAULT_SUBJECT}',
                                    to: emailextrecipients([
                                        [$class: 'CulpritsRecipientProvider'],
                                        [$class: 'RequesterRecipientProvider']
                                    ])
                                )
                            }
                        }
                    }
                }
            }
        }
    }
}
