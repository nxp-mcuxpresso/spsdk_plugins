@Library('shared-lib') _

// Abort older builds
def buildNumber = BUILD_NUMBER as int
if (buildNumber > 1) milestone(buildNumber - 1)
milestone(buildNumber)
pipeline {
    agent { label 'windows-spsdk' }
    // agent any
    options {
        timeout(time: 1, unit: 'HOURS', activity: true)   // timeout on whole pipeline job
    }
    stages {
            stage ("Checkout") {
                steps {
                    script {
                        bat 'git config core.longPaths true'
                        checkoutRepo()
                        checkoutRepo("spsdk", "master", "spsdk_repo")
                    }
                }
            }
        stage ("Test") {
            steps {
                script {
                    try {
                        withVenv(
                            "uv python install 3.10 3.14 && uv pip install nox tomli",
                            "nox -P 3.10 3.14 --session codecheck -- --spsdk spsdk_repo -s -o reports",
                        )
                    } finally {
                        archiveArtifacts(artifacts: '*/reports*/*.txt', allowEmptyArchive: true)
                        archiveArtifacts(artifacts: '*/reports*/*.html', allowEmptyArchive: true)
                        archiveArtifacts(artifacts: 'reports-summary/*.xml', allowEmptyArchive: true)
                        junit(allowEmptyResults: true, testResults: 'reports-summary/*.xml')
                        junit(allowEmptyResults: true, testResults: '*/reports*/tests.xml')
                    }
                }
            }
        }
    }
}